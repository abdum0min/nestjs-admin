{
  "name": "nest-admin-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root for Nest Admin - an auto-generated admin panel for NestJS applications.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" build",
    "prisma:setup": "node scripts/setup-prisma.mjs",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm prisma:setup && pnpm -r typecheck",
    "test": "pnpm prisma:setup && vitest run",
    "test:watch": "pnpm prisma:setup && vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "verify:package": "node scripts/verify-packed-consumer.mjs"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  }
}
