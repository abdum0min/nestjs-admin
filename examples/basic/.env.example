# SQLite keeps the example runnable with no external service.
DATABASE_URL="file:./dev.db"

# Optional. When set, the admin requires `x-admin-token: <value>`.
# Unset means every request is admitted - local development only.
# ADMIN_TOKEN="local-dev-token"

# Signs the admin's session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
