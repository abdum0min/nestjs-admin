# Dependencies
node_modules/
.pnpm-store/

# Build artefacts - never committed, produced by `pnpm build`
dist/
build/
out/
*.tsbuildinfo

# Test / coverage output
coverage/
.vitest/

# Local environment
.env
.env.*
!.env.example
# Points the admin UI at the dev proxy. A path, not a secret - and without it a
# fresh clone's dev server would fetch the API from itself and get HTML back.
!packages/admin-ui/.env.development

# Prisma local development database + generated client
*.db
*.db-journal
**/src/generated/
# Prisma client + SQLite file generated for the adapter integration tests
**/test/.generated/
**/prisma/migrations/dev.db*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# SQL emitted by `pnpm prisma:setup` to build a database from a schema.
# Regenerated on demand; never edited by hand.
**/prisma/.schema.sql

# Private working notes. Never committed, never pushed - they are for whoever
# is working on this machine, not for the repository. `.local.` in the name is
# the signal; the rule below is what enforces it.
*.local.md
