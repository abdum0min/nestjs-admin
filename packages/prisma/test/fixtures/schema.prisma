// Fixture schema for PrismaAdapter integration tests.
//
// Deliberately exercises every metadata attribute the adapter must map:
// an @id with a function default, a @unique, required and optional scalars,
// a literal boolean default, a literal-default enum, a now() default, an
// @updatedAt, and a one-to-many relation in both directions.

generator client {
  provider = "prisma-client"
  output   = "../.generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  bio       String?
  active    Boolean  @default(true)
  age       Int?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  managerId String?
  manager   User?    @relation("reports", fields: [managerId], references: [id])
  reports   User[]   @relation("reports")
}

model Product {
  id    String @id @default(cuid())
  name  String
  price Float
}

// Numeric primary keys, and relations between them.
//
// Ids arrive from a URL as strings, so every place one becomes a query
// argument has to coerce it. `Counter` used to have no relations, which meant
// the relation routes were only ever exercised against string keys - and the
// two places that forgot to coerce went unnoticed until a consumer hit them.
// The shapes below cover all three: a to-one inverse (`is`), a many-to-many
// (`some`), and a self-relation.
model Counter {
  id       Int       @id @default(autoincrement())
  label    String
  readings Reading[]
  markers  Marker[]
}

model Reading {
  id        Int       @id @default(autoincrement())
  value     Int
  counterId Int
  counter   Counter   @relation(fields: [counterId], references: [id])
  parentId  Int?
  parent    Reading?  @relation("chain", fields: [parentId], references: [id])
  children  Reading[] @relation("chain")
}

model Marker {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  counters Counter[]
}

model Post {
  id       String @id @default(cuid())
  title    String
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  tags     Tag[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  posts Post[]
}

enum Role {
  USER
  ADMIN
}
