{
  "name": "@nest-admin/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma adapter for Nest Admin. Implements the Core OrmAdapter contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nest-admin/core": "workspace:*",
    "@prisma/get-dmmf": "7.10.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.0.0 <9"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "catalog:",
    "@prisma/dmmf": "7.10.0",
    "prisma": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
