{
  "name": "@nest-admin/nest-admin",
  "version": "0.0.0",
  "description": "NestJS integration for Nest Admin. This is the single package published to npm.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js",
      "require": "./dist/prisma.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nest-admin/core": "workspace:*",
    "@nest-admin/prisma": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0 <13",
    "@nestjs/core": ">=10.0.0 <13",
    "@prisma/client": ">=6.0.0 <9",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@prisma/client": "catalog:",
    "@swc/core": "^1.16.1",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
