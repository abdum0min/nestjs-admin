{
  "name": "@nest-admin/nestjs",
  "version": "0.10.0",
  "description": "NestJS integration for Nest Admin. This is the single package published to npm.",
  "keywords": [
    "nestjs",
    "admin",
    "admin-panel",
    "admin-dashboard",
    "prisma",
    "crud",
    "backoffice",
    "generator",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      },
      "require": {
        "types": "./dist/prisma.d.cts",
        "default": "./dist/prisma.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "prisma": [
        "./dist/prisma.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-admin-ui.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/get-dmmf": "7.10.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0 <13",
    "@nestjs/core": ">=10.0.0 <13",
    "@prisma/client": "^7.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nest-admin/admin-ui": "workspace:*",
    "@nest-admin/core": "workspace:*",
    "@nest-admin/prisma": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/testing": "catalog:",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "catalog:",
    "@swc/core": "^1.16.1",
    "@types/supertest": "6.0.3",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "supertest": "7.1.4",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
